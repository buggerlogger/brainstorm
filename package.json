{
  "name": "brainstorm",
  "version": "0.2.0",
  "private": true,
  "description": "A context debugger for Claude Code sessions, as a desktop app: watch every API call frame by frame, edit the context, and resume on the edited session in the same terminal window.",
  "type": "module",
  "bin": {
    "brainstorm": "bin/brainstorm.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "app": "node bin/app.mjs",
    "ide": "node bin/brainstorm.mjs ide",
    "flow": "node bin/brainstorm.mjs flow",
    "build:exe": "node scripts/build-exe.mjs",
    "test": "node test/run.mjs",
    "test:all": "node test/run.mjs --all",
    "test:exe": "node test/run.mjs --exe"
  },
  "dependencies": {},
  "keywords": [
    "claude-code",
    "context",
    "transcript",
    "debugger"
  ],
  "license": "Apache-2.0",
  "author": "buggerlogger (https://github.com/buggerlogger)",
  "repository": {
    "type": "git",
    "url": "https://github.com/buggerlogger/brainstorm.git"
  }
}
